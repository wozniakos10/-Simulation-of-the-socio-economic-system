POLISH_DATA_2024 = {
    'average_gross_wage': 8279,  # średnie wynagrodzenie brutto w zł (GUS lipiec 2024)
    'average_net_wage': 7140,    # średnie wynagrodzenie netto w zł (GUS 2024)
    'inflation_rate': 0.047,     # inflacja 4.7% (grudzień 2024)
