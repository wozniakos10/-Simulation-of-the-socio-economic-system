    def apply_economic_cycle(self):
        """Symuluje cykle koniunkturalne i szoki ekonomiczne"""
        cycle_type = random.choice(['recesja', 'wzrost', 'stabilizacja'])
        
        if cycle_type == 'recesja':
            print(f"📉 Rok {self.step_count//12}: Recesja gospodarcza")
            for h in self.households:
                h.wealth *= 0.95  # spadek zamożności
                h.gross_wage *= 0.98  # spadek wynagrodzeń
            self.firm.base_costs *= 1.1  # wyższe koszty działalności
            
        elif cycle_type == 'wzrost':
